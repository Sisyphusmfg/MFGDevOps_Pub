{
  // Cloudflare Worker that serves sisyphusdev.com and its apps.
  // Workers Builds runs `npx wrangler deploy` from the repo root on every push to main.
  // The build step assembles dist/ from each domain that owns web files (SDEV-D-04).
  // Pull-request branches run `npx wrangler preview`, which needs the `previews` block below (SDEV-D-07).
  // Owner domain: Workstreams/Sisyphusdev_Site/ (see its INDEX.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mfgdevops-pub",
  // Routes app paths to their subdomain (SDEV-D-09); every other request is a static file from dist/.
  "main": "Workstreams/Sisyphusdev_Site/worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "bash scripts/build-site.sh"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "sisyphusdev.com", "custom_domain": true },
    { "pattern": "www.sisyphusdev.com", "custom_domain": true },
    // System Design and Analysis: POSIWID and Goal (SDEV-D-09).
    { "pattern": "purpose.sisyphusdev.com", "custom_domain": true },
    // Blog (BLOG-D-01).
    { "pattern": "blog.sisyphusdev.com", "custom_domain": true }
  ],
  // Scheduled blog posts (BLOG-D-05, SDEV-D-13): once a day the Worker checks
  // blog/schedule.json and, when a post's date has arrived, calls the Workers Builds
  // deploy hook in the BLOG_DEPLOY_HOOK secret. Cron times are UTC:
  // 11:15 UTC is 6:15 AM in New York in winter, 7:15 AM in summer.
  "triggers": {
    "crons": ["15 11 * * *"]
  },
  // Turns on workers.dev Preview URLs, so each PR gets a link. It takes effect on the next production deploy.
  // workers.dev Preview URLs are public, and Cloudflare adds X-Robots-Tag: noindex.
  "preview_urls": true,
  // Previews reuse the top-level settings. Production routes are never added here.
  "previews": {}
}
