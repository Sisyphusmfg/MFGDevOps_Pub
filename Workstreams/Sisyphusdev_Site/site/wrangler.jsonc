{
  // Static-assets Worker that serves sisyphusdev.com.
  // Deploy from this folder: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sisyphusdev-home",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "sisyphusdev.com", "custom_domain": true },
    { "pattern": "www.sisyphusdev.com", "custom_domain": true }
  ]
}
